# Supabase project URL (Project Settings -> API). Must be https.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key. Server-side only. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Long random secret sent in the X-Admin-Api-Key header for admin endpoints.
ADMIN_API_KEY=change-me-to-a-long-random-string-min-16-chars

# Comma-separated absolute origins allowed by CORS. No wildcard, no trailing slash.
CORS_ORIGIN=http://localhost:5173

# HTTP port. Railway/Render usually inject this value automatically.
PORT=3000

# Maximum JSON request body size accepted by express.json.
BODY_LIMIT=10kb

# Enable or disable the POST /api/register rate limiter. Only true or false.
RATE_LIMIT_ENABLED=true

# Rate limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window per client IP.
RATE_LIMIT_MAX=10
